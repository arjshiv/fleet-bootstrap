# Source this from .zshrc if you want the shared Oh My Zsh profile.
# Use the rest of .zshrc for machine-specific tools and preferences.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME=robbyrussell
plugins=(git colored-man-pages colorize pip python)
[[ $OSTYPE == darwin* ]] && plugins+=(brew macos)
for fleet_plugin in zsh-autosuggestions zsh-syntax-highlighting; do
  [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$fleet_plugin" ]] && plugins+=("$fleet_plugin")
done
unset fleet_plugin
[[ ! -r "$ZSH/oh-my-zsh.sh" ]] || source "$ZSH/oh-my-zsh.sh"
